# ════════════════════════════════════════════════════════════════
# AI Web Agency Agent — Production Environment Configuration (.env.production)
# ════════════════════════════════════════════════════════════════
# Generate secure 64-char keys by running:
#   python scripts/generate_production_secrets.py

# ── App Environment ──────────────────────────────────────────
APP_ENV=production
# 64-character hex string generated via secrets.token_hex(32)
APP_SECRET=REPLACE_WITH_GENERATED_64_CHAR_APP_SECRET
LOG_LEVEL=INFO

# ── Database (PostgreSQL 16) ─────────────────────────────────
# Async SQLAlchemy database URL (asyncpg)
DATABASE_URL=postgresql+asyncpg://agen:YOUR_STRONG_DB_PASS@localhost:5432/agen
# Sync database URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://agen:YOUR_STRONG_DB_PASS@localhost:5432/agen

# ── Redis 7 (Queue & Worker) ─────────────────────────────────
REDIS_URL=redis://:YOUR_REDIS_PASS@localhost:6379/0

# ── Authentication & Dashboard ───────────────────────────────
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_64_CHAR_NEXTAUTH_SECRET
CORS_ORIGINS=["https://yourdomain.com"]

# Owner Login Credentials
OWNER_EMAIL=owner@yourdomain.com
# Bcrypt hash generated via: python scripts/generate_production_secrets.py
OWNER_PASSWORD_HASH=REPLACE_WITH_BCRYPT_PASSWORD_HASH
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Token Encryption Keys (AES-256-GCM) ───────────────────────
# 32-byte urlsafe base64 keys
GMAIL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_KEY
DEPLOYMENT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_KEY

# ── AI Code Generation Engine ────────────────────────────────
AI_PROVIDER=nemotron
NEMOTRON_ENABLED=true
NEMOTRON_API_KEY=YOUR_NEMOTRON_API_KEY
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── Safeguards & Policy Enforcement ──────────────────────────
MAX_EMAILS_PER_DAY=30
MAX_EMAILS_PER_CAMPAIGN=200
EMAIL_COOLDOWN_HOURS=72
MAX_NEW_LEADS_PER_DAY=20
DOMAIN_PACING_SECONDS=120
