# ============================================================
# AI Web Agency Agent — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
APP_SECRET=change_me_to_a_random_64_char_string

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agen:agen_pass@localhost:5432/agen
DATABASE_URL_SYNC=postgresql://agen:agen_pass@localhost:5432/agen

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── NextAuth (Dashboard Auth) ────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_another_random_64_char_string

# ── Owner Credentials (single-user dashboard) ────────────────
OWNER_EMAIL=your@email.com
OWNER_PASSWORD_HASH=bcrypt_hash_here   # run: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpass'))"

# ── AI — Nemotron 3.5 Lightning ──────────────────────────────
NEMOTRON_API_KEY=your_nemotron_api_key
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── Gmail OAuth2 & Token Encryption (Phase 4) ────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=your_random_32_byte_base64_or_hex_encryption_key

# ── Google Maps / Places ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── GitHub ───────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_ORG=your_github_org_or_username

# ── Vercel ───────────────────────────────────────────────────
VERCEL_TOKEN=your_vercel_api_token
VERCEL_TEAM_ID=your_vercel_team_id   # optional

# ── Email Safeguards ─────────────────────────────────────────
MAX_EMAILS_PER_DAY=50
MAX_EMAILS_PER_CAMPAIGN=200
EMAIL_COOLDOWN_HOURS=72

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO
